{
  "name": "personal-finance",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.7.0"
  },
  "scripts": {
    "setup": "npm ci && git config core.hooksPath .githooks",
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev -H 127.0.0.1 -p ${APP_PORT:-3000}",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 NODE_ENV=production node server.ts",
    "app": "npm run build && npm run start",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "guard": "node scripts/data-guard.mjs --history",
    "prove:encryption": "node scripts/prove-encryption.ts"
  },
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "13.0.3",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "25.9.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
